# Copy to .env and replace every placeholder before starting the API.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

DATABASE_URL=postgresql+psycopg://secure_dms:change-me@127.0.0.1:5432/secure_dms
JWT_SECRET_KEY=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET_KEY=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=25

# Hybrid ranking weights. These are not secrets.
SEARCH_LEXICAL_WEIGHT=0.65
SEARCH_SEMANTIC_WEIGHT=0.35

# local uses an offline hashed embedding and does not download a model.
# fastembed uses EMBEDDING_MODEL and downloads that model on first use. No API key.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSIONS=384

# Optional full path to tesseract.exe when it is not on PATH.
TESSERACT_CMD=

# Case assistant. demo quotes retrieved text and is not a cloud model.
# local expects a local model name or path. This prototype does not download one.
LLM_PROVIDER=demo
LOCAL_LLM_MODEL=
RAG_TOP_K=6
MAX_CONTEXT_CHARS=6000
RAG_MAX_QUESTION_CHARS=1000
RAG_MIN_SCORE=0.55
RAG_RATE_LIMIT=20
RAG_RATE_WINDOW_SECONDS=60

# Non-owner login used by the API after row security is enabled.
# Create the role yourself. Do not put a generated password in this file.
# Alembic and the seed keep using DATABASE_URL.
APP_DATABASE_URL=

# Required before a new evidence or derived-artifact upload. Existing files stay readable.
STORAGE_MASTER_KEY=

# Optional. Approval still completes when this is empty and records that no signing key is configured.
APPROVAL_SIGNING_KEY=
